# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Твой Telegram user ID (узнать: @userinfobot). Админ всегда имеет доступ.
ADMIN_ID=123456789
# Домен, на котором будет жить Mini App (Caddy сам получит сертификат)
DOMAIN=subs.example.com
# Публичный URL мини-приложения; пусто — бот работает без Mini App
WEBAPP_URL=https://subs.example.com/
# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TZ=Europe/Moscow
